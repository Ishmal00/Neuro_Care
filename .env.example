# ==============================================================================
# NeuroCare-AI Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=True
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# FastAPI Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit UI Settings
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=neurocare_medical_knowledge

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=NeuroCare-Diagnostics

# Embedding & LLM Provider Settings (Optional / Configurable)
OPENAI_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2
DEVICE=cpu

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/neurocare.log
